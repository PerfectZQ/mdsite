{
  "name": "mdsite",
  "version": "0.2.2",
  "description": "Turn Markdown in any project into a searchable, self-contained documentation UI.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerfectZQ/mdsite.git"
  },
  "homepage": "https://github.com/PerfectZQ/mdsite#readme",
  "type": "module",
  "bin": {
    "mdsite": "dist/cli.js"
  },
  "files": [
    "doc/QUICK_START.md",
    "doc/CONTRIBUTING.md",
    "examples/build-with-docs.sh",
    "dist/**/*.js",
    "dist/assets/*.css",
    "dist/assets/*.txt"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/build.ts",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run check && npm test"
  },
  "dependencies": {
    "ignore": "7.0.9",
    "markdown-it": "15.0.2",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "parse5": "8.0.1",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "2.16.1",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2"
  }
}
